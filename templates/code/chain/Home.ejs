import { ElfUI } from "@elfui/chain";
import elfuiMark from "../assets/elfui-mark.png";
<% if (hasStyle) { -%>
import styles from "./page.<%= styleExtension %>?inline";
<% } -%>

export default ElfUI.createComponent()
  .name("elf-home-page")
  .template(
    `<section class="page home-page">
      <div class="hero">
        <div class="hero-copy">
          <div class="hero-lockup">
            <img class="hero-mark" src="${elfuiMark}" alt="" aria-hidden="true" />
            <h1 class="hero-title">ElfUI</h1>
            <p class="hero-description">一款专为组件而生的 Web Component 框架</p>
          </div>
          <elf-link class="hero-link" to="/example">查看组件示例 <span aria-hidden="true">→</span></elf-link>
        </div>
      </div>
    </section>`
  )
<% if (hasStyle) { -%>
  .style(styles)
<% } -%>
  .register();

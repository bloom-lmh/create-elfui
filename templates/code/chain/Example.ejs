import { ElfUI, useRef } from "@elfui/chain";
<% if (hasStyle) { -%>
import styles from "./page.<%= styleExtension %>?inline";
<% } -%>

export default ElfUI.createComponent()
  .name("elf-example-page")
  .setup(() => {
    const count = useRef(0);
    const increment = ()<% if (isTypeScript) { %>: void<% } %> => {
      count.set(count.peek() + 1);
    };
    const codeTick = "`";
    const codeArrow = "=>";
    const codeButtonOpen = '<button @click="increment">';
    const codeCount = "<strong>{{ count }}</strong>";
    const codeButtonClose = "<span>Increment</span></button>";
    return { count, increment, codeTick, codeArrow, codeButtonOpen, codeCount, codeButtonClose };
  })
  .template(
    `<section class="page example-page">
      <header class="example-heading">
        <p class="eyebrow">TS 单文件组件</p>
        <h1>优雅的组件定义方式</h1>
      </header>

      <div class="component-lab">
        <article class="code-panel" aria-label="TypeScript 单文件组件代码">
          <div class="panel-header">
            <span>Counter.ts</span>
            <span class="panel-badge">TS · Chain</span>
          </div>
          <pre class="code-content"><code>
<span class="code-line" data-line="1"><span class="token-keyword">import</span> { <span class="token-function">ElfUI</span>, <span class="token-function">useRef</span> } <span class="token-keyword">from</span> <span class="token-string">"@elfui/chain"</span>;</span>
<span class="code-line" data-line="2"><span class="token-keyword">const</span> count = <span class="token-function">useRef</span>(<span class="token-number">0</span>);</span>
<span class="code-line" data-line="3"><span class="token-keyword">const</span> increment = (): <span class="token-type">void</span> {{ codeArrow }} count.<span class="token-function">set</span>(count.<span class="token-function">peek</span>() + <span class="token-number">1</span>);</span>
<span class="code-line" data-line="4"><span class="token-keyword">export default</span> ElfUI.<span class="token-function">createComponent</span>()</span>
<span class="code-line indent-1" data-line="5">.<span class="token-function">setup</span>(() {{ codeArrow }} ({ count, increment }))</span>
<span class="code-line indent-1" data-line="6">.<span class="token-function">style</span>({{ codeTick }}<span class="token-selector">button</span> {</span>
<span class="code-line indent-2" data-line="7"><span class="token-property">width</span>: <span class="token-number">188px</span>; <span class="token-property">height</span>: <span class="token-number">128px</span>; <span class="token-property">border</span>: <span class="token-number">0</span>;</span>
<span class="code-line indent-2" data-line="8"><span class="token-property">border-radius</span>: <span class="token-number">18px</span>; <span class="token-property">background</span>: <span class="token-string">#47cae9</span>;</span>
<span class="code-line indent-1 token-selector" data-line="9">}</span>
<span class="code-line indent-1" data-line="10"><span class="token-selector">strong, span</span> { <span class="token-property">display</span>: block; }</span>
<span class="code-line indent-1" data-line="11"><span class="token-selector">strong</span> { <span class="token-property">font-size</span>: <span class="token-number">56px</span>; }{{ codeTick }})</span>
<span class="code-line indent-1" data-line="12">.<span class="token-function">template</span>({{ codeTick }}<span class="token-tag">{{ codeButtonOpen }}</span></span>
<span class="code-line indent-2 token-tag" data-line="13">{{ codeCount }}{{ codeButtonClose }}{{ codeTick }})</span>
<span class="code-line indent-1" data-line="14">.<span class="token-function">register</span>();</span>
          </code></pre>
        </article>

        <article class="preview-panel" aria-label="组件实时预览">
          <div class="panel-header preview-header">
            <span>实时预览</span>
            <span class="live-status"><i></i> 可交互</span>
          </div>
          <div class="preview-stage">
            <button class="counter-button" @click="increment">
              <strong>{{ count }}</strong>
              <span>Increment</span>
            </button>
          </div>
        </article>
      </div>
    </section>`
  )
<% if (hasStyle) { -%>
  .style(styles)
<% } -%>
  .register();

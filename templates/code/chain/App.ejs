import { ElfUI } from "@elfui/chain";
<% if (!router && !bare) { -%>
import elfuiMark from "./assets/elfui-mark.png";
<% } -%>
<% if (hasStyle) { -%>
import styles from "./App.<%= styleExtension %>?inline";
<% } -%>

export const App = ElfUI.createComponent()
  .name("elf-app")
  .template(
<% if (router) { -%>
    `<main class="app-shell">
      <div class="app-frame">
        <header class="app-header">
          <elf-link class="brand" to="/" aria-label="ElfUI 首页">ElfUI</elf-link>
          <nav class="app-nav" aria-label="主导航">
            <elf-link to="/">首页</elf-link>
            <elf-link to="/example">组件示例</elf-link>
          </nav>
          <span class="header-status">Chain + Vite</span>
        </header>
      </div>
      <elf-router-view></elf-router-view>
    </main>`
<% } else if (bare) { -%>
    `<main class="app-shell"></main>`
<% } else { -%>
    `<main class="app-shell">
      <div class="app-frame">
        <header class="app-header">
          <a class="brand" href="#home" aria-label="ElfUI 首页">ElfUI</a>
          <nav class="app-nav" aria-label="主导航">
            <a href="#home">首页</a>
          </nav>
          <span class="header-status">Chain + Vite</span>
        </header>

        <section class="hero" id="home">
          <div class="hero-copy">
            <div class="hero-lockup">
              <img class="hero-mark" src="${elfuiMark}" alt="" aria-hidden="true" />
              <h1 class="hero-title">ElfUI</h1>
              <p class="hero-description">一款专为组件而生的 Web Component 框架</p>
            </div>
          </div>
        </section>
      </div>
    </main>`
<% } -%>
  )
<% if (hasStyle) { -%>
  .style(styles)
<% } -%>
  .register();

export default App;

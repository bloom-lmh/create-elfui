import { defineHtml, html, useRef<% if (hasStyle) { %>, defineStyle<% } %> } from "@elfui/core";
<% if (hasStyle) { -%>
import styles from "./page.<%= styleExtension %>?inline";

defineStyle(styles);
<% } -%>

const count = useRef(0);
const increment = ()<% if (isTypeScript) { %>: void<% } %> => {
  count.set(count.peek() + 1);
};
const codeTick = "`";
const codeArrow = "=>";
const codeButton = '<button @click=${increment}>点击 ${count} 次</button>';

export default defineHtml(html`
  <section class="page example-page">
    <header class="example-heading">
      <p class="eyebrow">TS 单文件组件</p>
      <h1>几行代码，一个组件</h1>
      <p>状态与模板都在同一个 TypeScript 文件中。</p>
    </header>

    <div class="component-lab">
      <article class="code-panel" aria-label="TypeScript 单文件组件代码">
        <div class="panel-header">
          <span>Counter.ts</span>
          <span class="panel-badge">TS · Macro</span>
        </div>
        <pre class="code-content"><code>
<span class="code-line" data-line="1"><span class="token-keyword">import</span> { <span class="token-function">defineHtml</span>, <span class="token-function">html</span>, <span class="token-function">useRef</span> } <span class="token-keyword">from</span> <span class="token-string">"@elfui/core"</span>;</span>
<span class="code-line" data-line="2"></span>
<span class="code-line" data-line="3"><span class="token-keyword">const</span> count = <span class="token-function">useRef</span>(<span class="token-number">0</span>);</span>
<span class="code-line" data-line="4"><span class="token-keyword">const</span> increment = (): <span class="token-type">void</span> ${codeArrow} count.<span class="token-function">set</span>(count.<span class="token-function">peek</span>() + <span class="token-number">1</span>);</span>
<span class="code-line" data-line="5"></span>
<span class="code-line" data-line="6"><span class="token-keyword">export default</span> <span class="token-function">defineHtml</span>(<span class="token-function">html</span>${codeTick}</span>
<span class="code-line indent-1 token-tag" data-line="7">${codeButton}</span>
<span class="code-line" data-line="8">${codeTick});</span>
        </code></pre>
      </article>

      <article class="preview-panel" aria-label="组件实时预览">
        <div class="panel-header preview-header">
          <span>实时预览</span>
          <span class="live-status"><i></i> 可交互</span>
        </div>
        <div class="preview-stage">
          <button class="counter-button" @click=${increment}>点击 ${count} 次</button>
        </div>
      </article>
    </div>
  </section>
`);
